# ============================================================
# Data — GTFS raw feed (large, static, re-downloadable)
# ============================================================
# Ignore only .txt files, keep docs & placeholders tracked
data/raw/*.txt
!data/raw/.gitkeep
!data/raw/README.md

# ============================================================
# Data — Processed / synthetic outputs
# ============================================================
data/processed/*
!data/processed/.gitkeep

data/synthetic/*
!data/synthetic/.gitkeep

# Synthetic data (generated — commit the generator, not the output)
# Synthetic data (generated)
data/synthetic/*.csv
!data/synthetic/.gitkeep

# DPR data (source — commit the plan, but not generated copies)
data/dpr/*.csv
!data/dpr/.gitkeep
!data/dpr/hourly_service.csv

# Generated outputs
data/processed/*
!data/processed/.gitkeep